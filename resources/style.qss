/*
=== THEME VARIABLES ===
@bg-base: #1a1f1a;
@bg-mantle: #141914;
@bg-hover: #2a332a;
@text-main: #d4e8d4;
@text-dim: #8aab8a;
@accent: #5a9e5a;
@border: #2a332a;
=======================
*/

/* Main Background */
QMainWindow {
    background-color: @bg-base;
}

/* Navbar container */
QWidget#Navbar {
    background-color: @bg-mantle;
    border-right: 1px solid @border;
}

/* Content area */
QStackedWidget#ContentArea {
    background-color: @bg-base;
}

/* App Title */
QLabel#AppTitle {
    color: @text-main;
    padding: 20px 10px 20px 10px;
    border-bottom: 1px solid @border;
}

/* Feature Content Title */
QLabel#FeatureTitle {
    color: @text-main;
    padding: 30px;
}

/* Sidebar Tree Widget */
QTreeWidget {
    background-color: @bg-mantle;
    color: @text-dim;
    border: none;
    font-size: 20px;
    outline: none; /* remove focus dotted border */
    show-decoration-selected: 0;
}

QTreeWidget::item {
    padding: 12px;
    border-radius: 6px;
    margin: 2px 10px 2px 10px;
}

QTreeWidget::item:hover {
    background-color: @bg-hover;
    color: @text-main;
}

QTreeWidget::item:selected {
    background-color: @accent;
    color: @bg-base;
}

QTreeWidget::branch {
    background-color: transparent;
}

QTreeWidget::branch:selected {
    background-color: transparent;
}

/* Home Dashboard */
QLabel#DashboardTitle {
    color: @accent;
}

QLabel#DashboardSubtitle {
    color: @text-dim;
}

/* --- Refactored Widget Styles --- */

/* ToggleGroup */
QLabel#ToggleGroupLabel {
    color: #e0e0e0;
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 5px;
}
QPushButton#ToggleBtn {
    background-color: #333333;
    color: #e0e0e0;
    border: none;
    padding: 8px 15px;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#ToggleBtn:hover {
    background-color: #444444;
}
QPushButton#ToggleBtn:checked {
    background-color: #a6e3a1;
    color: #1e1e1e;
}

/* UploadBox */
QLabel#UploadDropLabel {
    border: 2px dashed #aaaaaa;
    border-radius: 10px;
    background-color: #252526;
    font-size: 18px;
    color: #e0e0e0;
    padding: 50px;
}
QPushButton#UploadSelectBtn {
    background-color: #333333;
    color: #e0e0e0;
    font-size: 16px;
    font-weight: bold;
    padding: 10px;
    border-radius: 5px;
    margin-top: 10px;
}
QPushButton#UploadSelectBtn:hover {
    background-color: #444444;
}
QPushButton#UploadGenerateBtn {
    background-color: #a6e3a1;
    color: #1e1e1e;
    font-size: 18px;
    font-weight: bold;
    padding: 15px;
    border-radius: 5px;
    margin-top: 10px;
}
QPushButton#UploadGenerateBtn:hover {
    background-color: #c3f0c9;
}
QPushButton#UploadGenerateBtn:disabled {
    background-color: #555555;
    color: #888888;
}

/* PlotView */
QLabel#PlotNoteLabel {
    color: #ffaa00;
    font-style: italic;
    font-size: 13px;
}
QPushButton#PlotDownloadBtn, QPushButton#PlotNewSampleBtn {
    font-size: 14px;
    font-weight: bold;
    padding: 10px;
    border-radius: 5px;
}
QPushButton#PlotDownloadBtn {
    background-color: #a6e3a1;
    color: #1e1e1e;
}
QPushButton#PlotDownloadBtn:hover {
    background-color: #c3f0c9;
}
QPushButton#PlotNewSampleBtn {
    background-color: #333333;
    color: #e0e0e0;
}
QPushButton#PlotNewSampleBtn:hover {
    background-color: #444444;
}
QWidget#PlotCanvas {
    background-color: transparent;
}

/* Loading Overlays */
QLabel#LoadingStartupTitle {
    color: white;
    font-size: 32px;
    font-weight: bold;
    margin-bottom: 20px;
}
QLabel#LoadingStartupStatus {
    color: #a0a0a0;
    font-size: 14px;
    font-style: italic;
}
QLabel#LoadingPanelStatus {
    color: white;
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 10px;
}
