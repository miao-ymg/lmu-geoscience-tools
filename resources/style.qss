/* style.qss - Theme variables are now injected from src/theme.py */

/* Global Font Settings */
* {
    font-family: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* Main Background */
QMainWindow {
    background-color: @bg-base;
}

/* Navbar container */
QWidget#Navbar {
    background-color: @bg-mantle;
    border-right: 1px solid @border-dark;
}

/* Navbar Header */
QWidget#NavbarHeader {
    background-color: transparent;
    border-bottom: 1px solid @border-dark;
    padding-bottom: 16px;
}

QLabel#AppTitle {
    font-family: "IBM Plex Serif", Georgia, "Times New Roman", serif;
    font-size: 19px;
    font-weight: 600;
    color: @text-white;
    padding: 0px;
    margin: 0px;
}

QLabel#AppSubtitle {
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 11px;
    letter-spacing: 0.5px;
    color: @text-accent;
    padding: 0px;
    margin: 0px;
}

/* Section Header in Sidebar */
QLabel#SidebarSectionHeader {
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 11.5px;
    letter-spacing: 0.5px;
    color: @text-sidebar-header;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 8px;
}

/* Content area */
QStackedWidget#ContentArea {
    background-color: @bg-base;
}

/* Feature Content Title */
QLabel#FeatureTitle {
    font-family: "IBM Plex Serif", Georgia, "Times New Roman", serif;
    font-size: 36px;
    font-weight: 600;
    color: @text-white;
    padding: 0px;
    margin: 0px;
}

/* Sidebar Tree Widget */
QTreeWidget {
    background-color: transparent;
    color: @text-dim;
    border: none;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 15px;
    font-weight: 500;
    outline: none;
    show-decoration-selected: 0;
}

QTreeWidget::viewport {
    background-color: transparent;
}

QTreeWidget::item {
    height: 42px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 6px;
    margin: 2px 14px 2px 14px;
    color: transparent; /* drawn by delegate */
    border: none;
}

QTreeWidget::branch {
    background-color: transparent;
    border: none;
    image: none;
}

QTreeWidget::branch:has-siblings:!adjoins-item {
    background-color: transparent;
    border: none;
    image: none;
}

QTreeWidget::branch:has-siblings:adjoins-item {
    background-color: transparent;
    border: none;
    image: none;
}

QTreeWidget::branch:!has-children:!has-siblings:adjoins-item {
    background-color: transparent;
    border: none;
    image: none;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    background-color: transparent;
    border: none;
    image: none;
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    background-color: transparent;
    border: none;
    image: none;
}

QTreeWidget::branch:selected {
    background-color: transparent;
    border: none;
    image: none;
}

/* Home Dashboard */
QWidget#HomeContainer {
    background-color: transparent;
}

QLabel#DashboardTitle {
    font-family: "IBM Plex Serif", Georgia, "Times New Roman", serif;
    font-size: 46px;
    font-weight: 600;
    color: @text-white;
    margin-bottom: 12px;
    background-color: transparent;
}

QLabel#DashboardSubtitle {
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: @text-instruction-note;
    background-color: transparent;
}

QLabel#HomeImageCredit {
    background-color: transparent;
    font-family: "IBM Plex Sans", sans-serif;
}
QLabel#HomeImageCredit a {
    color: @text-link;
    text-decoration: none;
}
QLabel#HomeImageCredit a:hover {
    color: @text-accent;
}

/* --- Refactored Widget Styles --- */

/* ToggleGroup */
QLabel#ToggleGroupLabel {
    color: @text-main;
    font-weight: 600;
    font-size: 17px;
    font-family: "IBM Plex Serif", Georgia, "Times New Roman", serif;
    margin-bottom: 2px;
}
QPushButton#ToggleBtn {
    background-color: #273140;
    color: #a0aab5;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 15px;
}
QPushButton#ToggleBtn:hover {
    background-color: #3a4a5e;
    color: @text-main;
}
QPushButton#ToggleBtn:checked {
    background-color: #467552;
    color: @toggle-text-checked;
    border: none;
}

/* UploadBox */
QFrame#UploadDropArea {
    border: 2px dashed #4e7330;
    border-radius: 12px;
    background-color: @bg-upload;
    padding: 30px;
}
QFrame#UploadDropArea:hover {
    border-color: @border-upload-hover;
    background-color: @bg-upload-hover;
}
QLabel#UploadIconBadge {
    background-color: @bg-upload-icon;
    border-radius: 28px;
    padding: 0px;
    font-size: 24px;
    color: @text-accent;
}
QLabel#UploadDropTitle {
    font-size: 16.5px;
    font-weight: 500;
    color: @text-white;
    background-color: transparent;
}
QLabel#UploadDropSubtitle {
    font-size: 13.5px;
    color: @text-upload-subtitle;
    background-color: transparent;
}
QFrame#InstructionsBox {
    background-color: @bg-upload;
    border: 1px solid #28313e;
    border-radius: 10px;
    padding: 12px 16px;
}
QLabel#InstructionsIcon {
    color: @text-accent;
    font-weight: bold;
    font-size: 19px;
}
QLabel#InstructionsHeader {
    color: @text-instruction-header;
    font-size: 15px;
    background-color: transparent;
}
QLabel#InstructionsBullet {
    color: @text-instruction-header;
    font-size: 14px;
    margin-top: 3px;
    margin-bottom: 3px;
    background-color: transparent;
}
QLabel#InstructionsNote {
    border-top: 1px solid #1a2330;
    margin-top: 14px;
    padding-top: 12px;
    font-style: italic;
    color: @text-instruction-note;
    font-size: 13.5px;
    background-color: transparent;
}
QPushButton#UploadGenerateBtn {
    background-color: @btn-primary;
    color: @text-white;
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 15px;
    font-weight: 700;
    padding: 15px;
    border-radius: 8px;
    border: 1px solid #4d7a58;
}
QPushButton#UploadGenerateBtn:hover {
    background-color: @btn-primary-hover;
}
QPushButton#UploadGenerateBtn:disabled {
    background-color: @bg-btn-disabled;
    color: @text-btn-disabled;
    border: 1px solid #223323;
}

/* PlotView */
QLabel#PlotNoteLabel {
    color: @text-warning;
    font-style: italic;
    font-size: 13px;
}
QPushButton#PlotDownloadBtn, QPushButton#PlotNewSampleBtn {
    font-size: 14px;
    font-weight: 600;
    padding: 15px;
    border-radius: 8px;
}
QPushButton#PlotDownloadBtn {
    background-color: @btn-primary;
    color: @text-white;
    border: 1px solid #4d7a58;
}
QPushButton#PlotDownloadBtn:hover {
    background-color: @btn-primary-hover;
}
QPushButton#PlotNewSampleBtn {
    background-color: @btn-secondary;
    color: @text-main;
    border: 1px solid #2a3647;
}
QPushButton#PlotNewSampleBtn:hover {
    background-color: @btn-secondary-hover;
}
QWidget#PlotCanvas {
    background-color: transparent;
}

/* Loading Overlays */
QLabel#LoadingStartupTitle {
    font-family: "IBM Plex Serif", Georgia, serif;
    color: @text-white;
    font-size: 32px;
    font-weight: 600;
    margin-bottom: 20px;
}
QLabel#LoadingStartupStatus {
    color: @text-sub;
    font-size: 14px;
}
QLabel#LoadingPanelStatus {
    color: @text-white;
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
}
